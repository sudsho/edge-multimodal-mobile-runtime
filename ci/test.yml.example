# CI config, kept out of .github/workflows on purpose. Copy to
# .github/workflows/test.yml when the workflow OAuth scope is available.

name: test

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-22.04
    strategy:
      matrix:
        python: ["3.10"]
    steps:
      - uses: actions/checkout@v4

      - name: setup python
        uses: actions/setup-python@v4
        with:
          python-version: ${{ matrix.python }}

      - name: cache pip
        uses: actions/cache@v3
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ hashFiles('requirements.txt') }}

      - name: install deps
        run: |
          python -m pip install --upgrade pip
          # coremltools bring in heavy transitive deps; we only need the pieces
          # required by the unit tests here.
          pip install torch==2.0.1 torchaudio==2.0.2 numpy==1.25.2 \
              onnx==1.14.1 onnxruntime==1.16.0 pytest==7.4.2 pyyaml==6.0.1

      - name: byte-compile
        run: python -m compileall src tests

      - name: run tests
        env:
          PYTHONPATH: ${{ github.workspace }}
        run: pytest -q
